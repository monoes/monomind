@@ -0,0 +1,13 @@
+import cb from './_cb.js';
+import each from './each.js';
+
+// Sum the values of a collection, optionally after mapping each one through an
+// iteratee (a function, property name or path, or matcher object).
+export default function sumBy(obj, iteratee, context) {
+  iteratee = cb(iteratee, context);
+  var sum = 0;
+  each(obj, function(value, key, list) {
+    sum += iteratee(value, key, list);
+  });
+  return sum;
+}
