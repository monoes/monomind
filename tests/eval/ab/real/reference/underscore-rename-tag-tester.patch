@@ -0,0 +1,9 @@
+import { toString } from './_setup.js';
+
+// Internal function for creating a `toString`-based type tester.
+export default function typeTester(name) {
+  var tag = '[object ' + name + ']';
+  return function(obj) {
+    return toString.call(obj) === tag;
+  };
+}
