  "documents": {
    "module-sheets-w1": {
      "schema": {
        "type": "object",
        "required": ["worker", "sheets"],
        "additionalProperties": false,
        "properties": {
          "worker": {
            "enum": ["worker-1"]
          },
          "sheets": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["module", "answers"],
              "additionalProperties": false,
              "properties": {
                "module": {
                  "enum": ["m1", "m2", "m3", "m4"]
                },
                "answers": {
                  "type": "array",
                  "minItems": 12,
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "required": ["q", "value", "files", "evidence"],
                    "additionalProperties": false,
                    "properties": {
                      "q": {
                        "enum": [
                          "q01",
                          "q02",
                          "q03",
                          "q04",
                          "q05",
                          "q06",
                          "q07",
                          "q08",
                          "q09",
                          "q10",
                          "q11",
                          "q12"
                        ]
                      },
                      "value": {
                        "type": "integer"
                      },
                      "files": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 7,
                        "items": {
                          "type": "string",
                          "minLength": 3
                        }
                      },
                      "evidence": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 7,
                        "items": {
                          "type": "object",
                          "required": ["file", "in", "out"],
                          "additionalProperties": false,
                          "properties": {
                            "file": {
                              "type": "string",
                              "minLength": 3
                            },
                            "in": {
                              "type": "integer"
                            },
                            "out": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "checks": [
        {
          "type": "value_type",
          "is": "integer"
        },
        {
          "type": "files_match_evidence"
        },
        {
          "type": "value_matches_chain"
        },
        {
          "type": "files_in_module"
        },
        {
          "type": "unique_across_sheets"
        }
      ],
      "max_publish_attempts": 4,
      "max_consistency_refusals": 5,
      "deliverable_files": [
        {
          "file": "out/m1/answers.json",
          "select": {
            "array": "sheets",
            "key": "module",
            "value": "m1"
          },
          "compare": ["module", "answers[].q", "answers[].value", "answers[].files"]
        },
        {
          "file": "out/m2/answers.json",
          "select": {
            "array": "sheets",
            "key": "module",
            "value": "m2"
          },
          "compare": ["module", "answers[].q", "answers[].value", "answers[].files"]
        },
        {
          "file": "out/m3/answers.json",
