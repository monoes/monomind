  "trials_per_arm": 3,
  "arms": [
    {
      "id": "baseline",
      "description": "Phase 2 without sections or documents: lead, four workers and a synthesiser coordinating by mail and tasks, same task text as treatment"
    },
    {
      "id": "treatment",
      "description": "The same roles plus the harness's publish/read/decide tools and cross-section org_send refusal: one section per worker pair, the synthesiser consuming module-sheet documents"
    },
    {
      "id": "single",
      "description": "The Phase 2 configuration with one role alone doing the whole task (all 8 modules and the synthesis) on the same model and the same deadline; no sections and no hand-off tools"
    }
  ],
  "per_run_allocation_usd": 12,
  "native_children": "disabled",
  "writer_authority": "each module sheet is written only by the worker that owns the module (single arm: by the one role) and the synthesis only by the synthesiser (single arm: the one role); the corpus is read-only in every arm",
