# monodesign hook state. Everything here is per-machine EXCEPT config.json,
# which is the shared detector config (hook-admin writes per-machine overrides
# to config.local.json instead). Ignoring the whole directory collapsed that
# split, so a shared ignore — e.g. excluding the detector's own test corpus,
# which is full of deliberate antipatterns used as fixtures — never reached
# CI or another developer.
.monodesign/*
!.monodesign/config.json

# org runtime cross-org mailbox scratch (<org workdir>/.mail/, orgrt/cross-org.ts)
.mail/
