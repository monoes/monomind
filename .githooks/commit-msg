#!/bin/bash
# Suggest a closing keyword for issues referenced as "(#N)" only (advisory,
# dependency-free, never blocks) — runs before the deps check on purpose.
if command -v node >/dev/null 2>&1 && [ -f scripts/commit-msg-issue-refs.mjs ]; then
  node scripts/commit-msg-issue-refs.mjs "$1" || true
fi

# Skip hook if deps not installed (fresh clone)
if [ ! -d "packages/@monomind/cli/node_modules" ]; then
  echo "[commit-msg] Skipping: deps not installed. Run npm install first."
  exit 0
fi

# Reject commits on improve/auto that don't follow the sprint-review format
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$BRANCH" = "improve/auto" ]; then
  MSG=$(cat "$1")
  if echo "$MSG" | grep -qiE "^(wip|fix|update|changes|misc|temp|checkpoint):"; then
    echo "ERROR: Commit message rejected — use format: fix(sprint-review): [ITEM-ID] description"
    exit 1
  fi
fi
exit 0
