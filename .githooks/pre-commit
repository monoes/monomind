#!/usr/bin/env bash
# Pre-commit hook: detect API keys, tokens, and other secrets in staged files.
#
# Self-contained — does not depend on a built dist artifact. The historical
# reference to `dist-cms/src/hooks/redaction-hook.js` pointed at a file that
# never existed in this repo, silently disabling the secret-leak gate every
# time the hook ran (it always hit the "skipping check" branch). See TOOL-1
# in docs/mastermind/plans/2026-08-11-swarm-audit-fixes.md.
#
# Bypass: SKIP_PRE_COMMIT=1 git commit ...
set -uo pipefail

if [ -n "${SKIP_PRE_COMMIT:-}" ]; then
  echo "🔒 Pre-commit secret scan skipped (SKIP_PRE_COMMIT set)"
  exit 0
fi

echo "🔒 Scanning staged files for secrets..."

# Scan only the lines a commit actually ADDS, read from the staged diff (so
# a partially-staged file's unstaged edits are not flagged, and content that
# was already committed in a prior commit is never re-flagged just because
# the file was touched again). Patterns mirror the SECRET_PATTERNS table in
# packages/@monomind/cli/src/utils/redaction.ts — kept inline so the hook
# works without a build step and without importing TypeScript.
node <<'NODE_SCAN'
const { execSync } = require('child_process');

// The three generic name=value rules below are the backstop for secrets in
// formats the specific rules don't know. Their value half is matched as a
// capture group so notASecretValue() can discard a hit whose "value" is
// plainly code rather than a literal — see that function for why a gate that
// cries wolf is worse than one rule fewer.
const GENERIC_VALUE_PATTERNS = [
  /(?:api[_-]?key|apikey)\s*[:=]\s*(['"]?[^\s'"]{8,}['"]?)/gi,
  /(?:secret|password|passwd|pwd)\s*[:=]\s*(['"]?[^\s'"]{8,}['"]?)/gi,
  /(?:token|bearer)\s*[:=]\s*(['"]?[^\s'"]{10,}['"]?)/gi,
];

// A literal secret cannot be any of these, so matching one is a false
// positive — and a false positive is not free: it trains people to reach for
// SKIP_PRE_COMMIT=1, which disables every rule in this file, not just the one
// that misfired. Each entry is a shape that is code or documentation by
// construction, never a pasted credential.
function notASecretValue(value) {
  const v = value.replace(/^['"]|['"]$/g, '');
  return (
    v.includes('${') ||                      // `?token=${apiToken}` — interpolation
    /^(?:process\.env|import\.meta\.env)\./.test(v) || // read from the environment
    /^<[^>]+>$/.test(v)                      // <your-token-here> — a docs placeholder
  );
}

const patterns = [
  /-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----[\s\S]*?-----END (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----/g,
  /sk-ant-[a-zA-Z0-9_-]{20,}/g,
  /sk-[a-zA-Z0-9_-]{20,}/g,
  /ghp_[a-zA-Z0-9]{36}/g,
  /gho_[a-zA-Z0-9]{36}/g,
  /npm_[a-zA-Z0-9]{36}/g,
  /AKIA[0-9A-Z]{16}/g,
  /eyJ[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{10,}/g, // JWT
];

const SKIP_EXT = /\.(png|jpg|jpeg|gif|webp|ico|pdf|zip|tar|gz|tgz|bz2|7z|lock|map|wasm|node|so|dylib|dll|exe|bin)$/i;
const MAX_BYTES = 1024 * 1024; // 1 MB per file's staged diff

let files;
try {
  const out = execSync('git diff --cached --name-only --diff-filter=ACM -z', {
    encoding: 'utf-8',
    stdio: ['pipe', 'pipe', 'ignore'],
  });
  files = out.split('\0').filter(Boolean);
} catch {
  process.exit(0); // not a git repo / no staged files
}

// Returns the newline-joined text of only the '+' lines from the staged
// diff for one path (i.e. content this commit is introducing), or null if
// the diff can't be read (too large / binary / error — skip silently, same
// as the prior full-blob scan's behavior for unreadable files).
function addedLines(relPath) {
  let diff;
  try {
    diff = execSync(`git diff --cached --unified=0 --no-color -- ${JSON.stringify(relPath)}`, {
      encoding: 'utf-8',
      maxBuffer: MAX_BYTES,
      stdio: ['pipe', 'pipe', 'ignore'],
    });
  } catch {
    return null;
  }
  const added = [];
  for (const line of diff.split('\n')) {
    if (line.startsWith('+++')) continue; // file header, not content
    if (line.startsWith('+')) added.push(line.slice(1));
  }
  return added.join('\n');
}

let hits = 0;
for (const relPath of files) {
  if (SKIP_EXT.test(relPath)) continue;
  const content = addedLines(relPath);
  if (!content) continue;
  for (const p of GENERIC_VALUE_PATTERNS) {
    for (const m of content.matchAll(p)) {
      if (notASecretValue(m[1])) continue;
      const preview = m[0].length > 50 ? `${m[0].slice(0, 50)}…` : m[0];
      console.error(`  ❌ ${relPath}: ${preview}`);
      hits++;
    }
  }
  for (const p of patterns) {
    const matches = content.match(p);
    if (!matches) continue;
    for (const m of matches) {
      const preview = m.length > 50 ? `${m.slice(0, 50)}…` : m;
      console.error(`  ❌ ${relPath}: ${preview}`);
      hits++;
    }
  }
}

if (hits > 0) {
  console.error(`\n❌ COMMIT BLOCKED — ${hits} secret-pattern match(es) in staged files.`);
  console.error('    Remove the secret(s), or bypass with: SKIP_PRE_COMMIT=1 git commit ...');
  process.exit(1);
}
console.error('✅ No secret patterns found in staged files');
NODE_SCAN

exit $?
