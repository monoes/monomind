#!/usr/bin/env bash
# Pre-commit hook: detect API keys, tokens, and other secrets in staged files.
#
# Self-contained — does not depend on a built dist artifact. The historical
# reference to `dist-cms/src/hooks/redaction-hook.js` pointed at a file that
# never existed in this repo, silently disabling the secret-leak gate every
# time the hook ran (it always hit the "skipping check" branch). See TOOL-1
# in docs/mastermind/plans/2026-08-11-swarm-audit-fixes.md.
#
# Bypass: SKIP_PRE_COMMIT=1 git commit ...
set -uo pipefail

if [ -n "${SKIP_PRE_COMMIT:-}" ]; then
  echo "🔒 Pre-commit secret scan skipped (SKIP_PRE_COMMIT set)"
  exit 0
fi

echo "🔒 Scanning staged files for secrets..."

# Read staged content straight from the git index (so a partially-staged
# file's unstaged edits are not flagged). Patterns mirror the SECRET_PATTERNS
# table in packages/@monomind/cli/src/utils/redaction.ts — kept inline so the
# hook works without a build step and without importing TypeScript.
node <<'NODE_SCAN'
const { execSync } = require('child_process');

const patterns = [
  /(?:api[_-]?key|apikey)\s*[:=]\s*['"]?[^\s'"]{8,}['"]?/gi,
  /(?:secret|password|passwd|pwd)\s*[:=]\s*['"]?[^\s'"]{8,}['"]?/gi,
  /(?:token|bearer)\s*[:=]\s*['"]?[^\s'"]{10,}['"]?/gi,
  /-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----[\s\S]*?-----END (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----/g,
  /sk-ant-[a-zA-Z0-9_-]{20,}/g,
  /sk-[a-zA-Z0-9_-]{20,}/g,
  /ghp_[a-zA-Z0-9]{36}/g,
  /gho_[a-zA-Z0-9]{36}/g,
  /npm_[a-zA-Z0-9]{36}/g,
  /AKIA[0-9A-Z]{16}/g,
  /eyJ[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{10,}/g, // JWT
];

const SKIP_EXT = /\.(png|jpg|jpeg|gif|webp|ico|pdf|zip|tar|gz|tgz|bz2|7z|lock|map|wasm|node|so|dylib|dll|exe|bin)$/i;
const MAX_BYTES = 1024 * 1024; // 1 MB per file

let files;
try {
  const out = execSync('git diff --cached --name-only --diff-filter=ACM -z', {
    encoding: 'utf-8',
    stdio: ['pipe', 'pipe', 'ignore'],
  });
  files = out.split('\0').filter(Boolean);
} catch {
  process.exit(0); // not a git repo / no staged files
}

let hits = 0;
for (const relPath of files) {
  if (SKIP_EXT.test(relPath)) continue;
  let content;
  try {
    content = execSync(`git show :${relPath}`, {
      encoding: 'utf-8',
      maxBuffer: MAX_BYTES,
      stdio: ['pipe', 'pipe', 'ignore'],
    });
  } catch {
    continue; // deleted / binary / too large — skip silently
  }
  for (const p of patterns) {
    const matches = content.match(p);
    if (!matches) continue;
    for (const m of matches) {
      const preview = m.length > 50 ? `${m.slice(0, 50)}…` : m;
      console.error(`  ❌ ${relPath}: ${preview}`);
      hits++;
    }
  }
}

if (hits > 0) {
  console.error(`\n❌ COMMIT BLOCKED — ${hits} secret-pattern match(es) in staged files.`);
  console.error('    Remove the secret(s), or bypass with: SKIP_PRE_COMMIT=1 git commit ...');
  process.exit(1);
}
console.error('✅ No secret patterns found in staged files');
NODE_SCAN

exit $?
