{
  "name": "@monoes/monodesign",
  "version": "1.2.5",
  "description": "Frontend design intelligence for AI agents — design tokens, antipattern detection, and the monodesign skill",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tokens": "./src/tokens.css",
    "./engine": "./cli/engine/detect-antipatterns.mjs",
    "./engine/browser": "./cli/engine/detect-antipatterns-browser.js"
  },
  "bin": {
    "monodesign": "cli/bin/cli.js"
  },
  "files": [
    "cli/",
    "dist/",
    "skill/",
    "src/tokens.css",
    "NOTICE.md"
  ],
  "scripts": {
    "prebuild": "node ../../../scripts/build-fs.mjs clean dist tsconfig.tsbuildinfo",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "sync": "node scripts/sync-skill.mjs"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "antipattern",
    "frontend",
    "monomind",
    "oklch",
    "ui",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "marked": "^18.0.0"
  },
  "optionalDependencies": {
    "@monoes/monobrowse": "^1.0.7",
    "puppeteer": "^25.1.0"
  }
}
