{
  "name": "@monoes/monograph",
  "version": "1.5.8",
  "type": "module",
  "description": "Code intelligence engine for monomind — tree-sitter WASM grammars + SQLite knowledge graph, no native builds",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./export": {
      "types": "./dist/src/export/index.d.ts",
      "import": "./dist/src/export/index.js"
    },
    "./export/*": {
      "types": "./dist/src/export/*.d.ts",
      "import": "./dist/src/export/*.js"
    },
    "./lsp": {
      "types": "./dist/src/lsp/server.d.ts",
      "import": "./dist/src/lsp/server.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "prebuild": "node ../../../scripts/build-fs.mjs clean dist tsconfig.tsbuildinfo",
    "build": "tsc && node ../../../scripts/build-fs.mjs clean dist/wasm && node ../../../scripts/build-fs.mjs copy-dir wasm dist/wasm",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.0.2",
    "graphology-traversal": "^0.3.1",
    "micromatch": "^4.0.8",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^20.0.0",
    "tree-sitter": "^0.22.0",
    "tree-sitter-c": "~0.23.6",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-go": "^0.23.0",
    "tree-sitter-java": "^0.23.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "~0.23.11",
    "tree-sitter-python": "^0.23.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.23.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.0",
    "tree-sitter-cli": "0.27.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  }
}
