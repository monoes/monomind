{
  "name": "monomind",
  "version": "2.15.6",
  "description": "Open-source CLI extension for Claude Code, OpenCode, Antigravity, Kimi Code, and Codex. Adds an MCP server with a codebase knowledge graph, persistent memory, multi-agent coordination, and reusable slash commands. Apache 2.0 licensed. See https://github.com/monoes/monomind/blob/main/doc/privacy.md for what leaves your machine and when.",
  "type": "module",
  "bin": {
    "monomind": "./bin/cli.js"
  },
  "homepage": "https://github.com/monoes/monomind#readme",
  "bugs": {
    "url": "https://github.com/monoes/monomind/issues",
    "email": "support@monoes.me"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nokhodian"
  },
  "files": [
    "bin/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node -e \"if(process.platform!=='win32'){try{require('child_process').execSync('find node_modules -name ._* -delete 2>/dev/null',{stdio:'ignore'})}catch{}}\"",
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "cd packages/@monomind/cli && tsx watch src/index.ts",
    "build": "pnpm -r run build",
    "build:ts": "cd packages/@monomind/cli && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:versions": "node scripts/check-publish-versions.mjs && node scripts/check-package-bumps.mjs && node scripts/check-workspace-protocol.mjs && node scripts/check-overrides-source.mjs",
    "docs:counts": "node scripts/generate-doc-counts.mjs",
    "docs:counts:check": "node scripts/generate-doc-counts.mjs --check",
    "docs:refs:check": "node scripts/check-doc-refs.mjs",
    "sync:claude-trees": "node scripts/sync-claude-trees.mjs",
    "sync:claude-trees:check": "node scripts/sync-claude-trees.mjs --check",
    "prepublishOnly": "node scripts/check-publish-versions.mjs && node scripts/check-package-bumps.mjs && node scripts/check-workspace-protocol.mjs && node scripts/check-overrides-source.mjs && node scripts/check-published-pins.mjs . && node scripts/generate-doc-counts.mjs --check && node scripts/check-doc-refs.mjs && cd packages/@monomind/cli && npm run build",
    "test": "vitest",
    "test:all": "vitest --config vitest.workspace.ts",
    "test:run": "vitest run",
    "test:all:run": "vitest run --config vitest.workspace.ts",
    "test:ui": "vitest --ui",
    "test:security": "vitest run tests/security/",
    "test:semantic-eval": "node --test tests/memory/cognee-port-eval.test.mjs",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run docs:refs:check && pnpm run sync:claude-trees:check && pnpm run test:all:run && pnpm --filter @monoes/monobrowse test && pnpm --filter @monoes/monodesign test && pnpm --filter monofence-ai test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:skills": "node scripts/lint-skills.mjs",
    "format": "biome format --write",
    "security:audit": "pnpm audit --audit-level high",
    "security:fix": "pnpm audit --fix",
    "security:test": "npm run test:security",
    "v1:domains": "npm run build:domains",
    "v1:swarm": "npm run start:swarm",
    "v1:security": "npm run security:audit && npm run security:test"
  },
  "dependencies": {
    "@monoes/monomindcli": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@monoes/monograph": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "better-sqlite3": ">=12.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": ">=8.0.16",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/monoes/monomind.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "automation",
    "workflow",
    "cli",
    "developer-tools",
    "devtools",
    "coding-assistant",
    "code-generation",
    "knowledge-graph",
    "code-analysis",
    "monomind",
    "organizations",
    "autonomous-agents",
    "hooks",
    "antigravity",
    "agy",
    "gemini"
  ],
  "author": {
    "name": "nokhodian",
    "email": "nokhodian@gmail.com",
    "url": "https://github.com/nokhodian"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "volta": {
    "node": "22.23.2"
  }
}
