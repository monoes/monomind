{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/@monomind/*/src/**",
      "packages/@monoes/*/src/**",
      "packages/*/__tests__/**",
      "packages/@monomind/*/__tests__/**",
      "packages/@monoes/*/__tests__/**",
      "packages/@monoes/*/tests/**",
      "!packages/@monomind/monograph/__tests__/fixtures",
      "!packages/@monoes/monodesign/tests/fixtures",
      "packages/@monoes/monodesign/cli/**",
      "packages/@monoes/monodesign/skill/**",
      "packages/@monoes/monodesign/scripts/**",
      "!packages/@monoes/monodesign/skill/scripts/modern-screenshot.umd.js",
      "tests/**",
      "scripts/**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!.monomind",
      "!.claude",
      "!**/docs",
      "!**/doc",
      "!**/*.d.ts",
      "!**/._*"
    ]
  },
  "overrides": [
    {
      "includes": [
        "packages/@monomind/cli/src/ui/**",
        "packages/@monoes/monobrowse/src/browser/dashboard/**"
      ],
      "linter": {
        "rules": {
          "a11y": "off"
        }
      }
    },
    {
      "includes": [
        "packages/*/__tests__/**",
        "packages/@monomind/*/__tests__/**",
        "packages/@monoes/*/__tests__/**",
        "packages/@monoes/*/tests/**"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "correctness": {
            "useYield": "off",
            "noUnusedFunctionParameters": "off"
          },
          "complexity": {
            "noAdjacentSpacesInRegex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/@monoes/monodesign/cli/**",
        "packages/@monoes/monodesign/skill/**",
        "packages/@monoes/monodesign/scripts/**"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": "off",
        "noExportsInTest": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noEmptyBlock": "off",
        "noTsIgnore": "off",
        "noDuplicateElseIf": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noCommaOperator": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off",
        "noUnsafeOptionalChaining": "off",
        "noEmptyCharacterClassInRegex": "off"
      },
      "security": {
        "noGlobalEval": "off"
      }
    }
  }
}
