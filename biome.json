{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/@monomind/*/src/**",
      "tests/**",
      "scripts/**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/.monomind",
      "!**/.claude",
      "!**/docs",
      "!**/doc",
      "!**/*.d.ts",
      "!**/._*"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/@monomind/cli/src/ui/**"],
      "linter": {
        "rules": {
          "a11y": "off"
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "bracketSpacing": true,
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "noTemplateCurlyInString": "off",
        "useIterableCallbackReturn": "off",
        "noExportsInTest": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noEmptyBlock": "off",
        "noTsIgnore": "off",
        "noDuplicateElseIf": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noCommaOperator": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off",
        "noUnsafeOptionalChaining": "off",
        "noEmptyCharacterClassInRegex": "off"
      },
      "security": {
        "noGlobalEval": "off"
      }
    }
  }
}
